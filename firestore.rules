rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Seul le compte de Marion est administrateur (UID copié depuis Firebase → Authentication → Utilisateurs)
    function estAdmin() { return request.auth != null && request.auth.uid == '5FnXueJRCyed0lFy8psaIVK2hj93'; }
    // Une ligne de commande déposée par un client : rien d'autre que ces champs, de la bonne taille
    function ligneOk(l) {
      return l is map && l.keys().hasOnly(['id','nom','choix','personnes','prixPersonne','montant'])
        && l.id is string && l.id.size() <= 40
        && l.nom is string && l.nom.size() > 0 && l.nom.size() <= 300
        && l.personnes is int && l.personnes >= 1 && l.personnes <= 200
        && l.prixPersonne is number && l.prixPersonne >= 0 && l.prixPersonne <= 500
        && l.montant is number && l.montant >= 0 && l.montant <= 5000
        && (!('choix' in l) || (l.choix is list && l.choix.size() <= 12));
    }
    function lignesOk(ls) {
      return (ls.size() < 1 || ligneOk(ls[0])) && (ls.size() < 2 || ligneOk(ls[1])) && (ls.size() < 3 || ligneOk(ls[2]))
        && (ls.size() < 4 || ligneOk(ls[3])) && (ls.size() < 5 || ligneOk(ls[4])) && (ls.size() < 6 || ligneOk(ls[5]))
        && (ls.size() < 7 || ligneOk(ls[6])) && (ls.size() < 8 || ligneOk(ls[7])) && (ls.size() < 9 || ligneOk(ls[8]))
        && (ls.size() < 10 || ligneOk(ls[9]));
    }
    match /shop/config   { allow read: if true; allow write: if estAdmin(); }
    match /offres/{id}   { allow read: if true; allow write: if estAdmin(); }
    match /actus/{id}    { allow read: if true; allow write: if estAdmin(); }
    // Articles du jour : seule l'épicerie publie. Un client peut seulement augmenter le compteur
    // de réservations, sans dépasser la quantité disponible (pas de surréservation possible).
    match /jour/{id} {
      allow read: if true;
      allow write: if estAdmin();
      // … et seulement en créant la réservation correspondante dans la même opération (derniereResa)
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reserves', 'derniereResa'])
        && resource.data.get('stock', 0) is int && resource.data.get('stock', 0) > 0
        && request.resource.data.reserves is int
        && request.resource.data.reserves > resource.data.get('reserves', 0)
        && request.resource.data.reserves - resource.data.get('reserves', 0) <= 10
        && request.resource.data.reserves <= resource.data.get('stock', 0)
        && request.resource.data.derniereResa is string && request.resource.data.derniereResa.size() >= 15 && request.resource.data.derniereResa.size() <= 40
        && !exists(/databases/$(database)/documents/resas/$(request.resource.data.derniereResa))
        && getAfter(/databases/$(database)/documents/resas/$(request.resource.data.derniereResa)).data.item == id
        && getAfter(/databases/$(database)/documents/resas/$(request.resource.data.derniereResa)).data.qte == request.resource.data.reserves - resource.data.get('reserves', 0);
    }
    // Réservations anti-gaspi : créées avec la hausse du compteur de l'article (même opération),
    // lisibles par leur identifiant secret ; seule l'épicerie les liste, modifie ou supprime.
    match /resas/{id} {
      allow get: if true;
      allow list, update, delete: if estAdmin();
      allow create: if estAdmin() || (
        request.resource.data.keys().hasOnly(['numero','cree','statut','item','titre','qte','prix','total','nom','tel','retrait'])
        && request.resource.data.keys().hasAll(['numero','cree','statut','item','titre','qte','prix','total','nom','tel','retrait'])
        && request.resource.data.statut == 'reservee'
        && request.resource.data.numero is string && request.resource.data.numero.matches('R-[A-Z0-9]{5}')
        && request.resource.data.cree is int
        && request.resource.data.qte is int && request.resource.data.qte >= 1 && request.resource.data.qte <= 10
        && request.resource.data.item is string && request.resource.data.item.size() <= 40
        && request.resource.data.titre is string && request.resource.data.titre.size() <= 80
        && request.resource.data.prix is number && request.resource.data.total is number && request.resource.data.total <= 1000
        && request.resource.data.nom is string && request.resource.data.nom.size() > 0 && request.resource.data.nom.size() <= 40
        && request.resource.data.tel is string && request.resource.data.tel.size() <= 20
        && request.resource.data.retrait is string && request.resource.data.retrait.size() <= 60
        && getAfter(/databases/$(database)/documents/jour/$(request.resource.data.item)).data.get('reserves', 0)
           == get(/databases/$(database)/documents/jour/$(request.resource.data.item)).data.get('reserves', 0) + request.resource.data.qte);
    }
    match /pubs/{id}     { allow read: if true; allow write: if estAdmin(); }
    match /producteurs/{id} { allow read: if true; allow write: if estAdmin(); }
    match /recettes/{id}    { allow read: if true; allow write: if estAdmin(); }
    // Réponses aux sondages : anonymes, une seule par téléphone (pas de modification), seulement pour le sondage en cours
    match /reponses/{id} {
      allow read, delete: if estAdmin();
      allow create: if request.resource.data.keys().hasOnly(['s','o','r','cree'])
        && request.resource.data.s is string && request.resource.data.s.matches('s[0-9]{6,20}')
        && id.matches(request.resource.data.s + '_[a-z0-9]{8,40}')
        && get(/databases/$(database)/documents/shop/config).data.sondage.id == request.resource.data.s
        && get(/databases/$(database)/documents/shop/config).data.sondage.active == true
        && request.resource.data.o is int && request.resource.data.o >= -1 && request.resource.data.o <= 9
        && request.resource.data.r is string && request.resource.data.r.size() <= 500
        && request.resource.data.cree is int;
    }
    match /plateaux/{id} { allow read: if true; allow write: if estAdmin(); }

    // Commandes de plateaux : un client peut seulement EN DÉPOSER une (contrôlée champ par champ)
    // et suivre la sienne grâce à son identifiant secret (gardé sur son téléphone).
    // Personne ne peut parcourir la liste ; seule l'épicerie modifie ou supprime.
    match /commandes/{id} {
      allow get: if true;
      allow list, update, delete: if estAdmin();
      allow create: if estAdmin() || (
        request.resource.data.keys().hasOnly(['numero','cree','statut','nom','tel','mode','adresse','date','remarque','carte','lignes','total'])
        && request.resource.data.keys().hasAll(['numero','cree','statut','nom','tel','mode','adresse','date','remarque','carte','lignes','total'])
        && request.resource.data.statut == 'nouvelle'
        && request.resource.data.numero is string && request.resource.data.numero.matches('C-[A-Z0-9]{5}')
        && request.resource.data.cree is int
        && request.resource.data.nom is string && request.resource.data.nom.size() > 0 && request.resource.data.nom.size() <= 60
        && request.resource.data.tel is string && request.resource.data.tel.size() >= 10 && request.resource.data.tel.size() <= 20
        && request.resource.data.mode in ['retrait', 'livraison']
        && request.resource.data.adresse is string && request.resource.data.adresse.size() <= 200
        && request.resource.data.date is string && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.remarque is string && request.resource.data.remarque.size() <= 500
        && request.resource.data.carte is string && request.resource.data.carte.size() <= 10
        && request.resource.data.lignes is list && request.resource.data.lignes.size() >= 1 && request.resource.data.lignes.size() <= 10
        && lignesOk(request.resource.data.lignes)
        && request.resource.data.total is number && request.resource.data.total > 0 && request.resource.data.total <= 5000);
    }
    // Messagerie clients ↔ épicerie : chaque client ne voit que SA conversation (identifiant secret
    // gardé sur son téléphone). Personne ne peut parcourir la liste ; seule l'épicerie supprime.
    match /conversations/{id} {
      allow get: if true;
      allow list, delete: if estAdmin();
      allow create: if estAdmin() || (
        request.resource.data.keys().hasOnly(['nom','tel','cree','maj','dernier','attente'])
        && request.resource.data.keys().hasAll(['nom','tel','cree','maj','dernier','attente'])
        && request.resource.data.nom is string && request.resource.data.nom.size() > 0 && request.resource.data.nom.size() <= 40
        && request.resource.data.tel is string && request.resource.data.tel.size() <= 20
        && request.resource.data.cree is int && request.resource.data.maj is int
        && request.resource.data.dernier is string && request.resource.data.dernier.size() <= 120
        && request.resource.data.attente == true);
      allow update: if estAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['maj','dernier','attente'])
        && request.resource.data.maj is int
        && request.resource.data.dernier is string && request.resource.data.dernier.size() <= 120
        && request.resource.data.attente == true);
      match /messages/{m} {
        allow read: if true;
        allow create: if estAdmin() || (
          request.resource.data.keys().hasOnly(['de','texte','date'])
          && request.resource.data.keys().hasAll(['de','texte','date'])
          && existsAfter(/databases/$(database)/documents/conversations/$(id))
          && request.resource.data.de == 'client'
          && request.resource.data.texte is string && request.resource.data.texte.size() > 0 && request.resource.data.texte.size() <= 1000
          && request.resource.data.date is int);
        allow update: if false;
        allow delete: if estAdmin();
      }
    }
    // Notifications : chaque téléphone abonné a sa fiche (identifiant secret gardé sur le téléphone).
    // Elle ne contient que le jeton technique, les identifiants suivis et le choix « bons plans ».
    // Personne ne peut parcourir la liste (seule l'épicerie et le script d'envoi la voient).
    match /appareils/{id} {
      allow get, delete: if true;
      allow list: if estAdmin();
      allow create, update: if id.size() >= 20 && id.size() <= 40
        && request.resource.data.keys().hasOnly(['token','refs','promo','maj'])
        && request.resource.data.keys().hasAll(['token','refs','promo','maj'])
        && request.resource.data.token is string && request.resource.data.token.size() > 20 && request.resource.data.token.size() <= 400
        && request.resource.data.refs is list && request.resource.data.refs.size() <= 40
        && request.resource.data.promo is bool
        && request.resource.data.maj is int;
    }
    // Mesure d'audience ANONYME : un compteur par jour et par rubrique (stats/{AAAA-MM-JJ}_{cle} = { jour, cle, n }).
    // Les clients peuvent seulement l'augmenter de 1 ; seule l'épicerie lit et fait le ménage.
    match /stats/{id} {
      allow read, delete: if estAdmin();
      allow create: if id.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}_[a-z0-9_-]{1,50}')
        && request.resource.data.keys().hasOnly(['jour','cle','n'])
        && request.resource.data.jour is string && request.resource.data.cle is string
        && id == request.resource.data.jour + '_' + request.resource.data.cle
        && request.resource.data.n == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n'])
        && request.resource.data.n == resource.data.n + 1;
    }
    // Connexions à l'admin et à la caisse (date, type d'appareil) : réservé à l'épicerie
    match /connexions/{id} {
      allow read, create, delete: if estAdmin();
      allow update: if false;
    }
    // Téléphones de Marion qui reçoivent les notifications (nouvelle commande, réservation, message) :
    // réservé à l'épicerie ; le script d'envoi les lit avec son compte de service.
    // Tirages au sort de la roue de Noël (gagnant, participants) : réservés à l'épicerie
    match /tirages/{id} { allow read, write: if estAdmin(); }
    match /appareilsAdmin/{id} {
      allow read, delete: if estAdmin();
      allow create, update: if estAdmin() && id.size() >= 20 && id.size() <= 40
        && request.resource.data.keys().hasOnly(['token','appareil','maj'])
        && request.resource.data.token is string && request.resource.data.token.size() > 20 && request.resource.data.token.size() <= 400
        && request.resource.data.appareil is string && request.resource.data.appareil.size() <= 60
        && request.resource.data.maj is int;
    }
    // Codes de carte déjà attribués : un client peut réserver un code libre en créant sa carte, jamais en reprendre un.
    match /codes/{code} {
      allow read, update, delete: if estAdmin();
      allow create: if estAdmin() || (code.matches('RAD-[A-Z0-9]{5}')
        && request.resource.data.keys().hasOnly(['c']) && request.resource.data.c is string
        && getAfter(/databases/$(database)/documents/clients/$(request.resource.data.c)).data.code == code);
    }
    // Messages envoyés par Marion à tous les clients : réservé à l'épicerie
    match /diffusions/{id} { allow read, write: if estAdmin(); }
    match /clients/{id} {
      allow get: if true;
      allow list: if estAdmin();
      allow create: if estAdmin() || (
        // le code doit être réservé en même temps dans codes/{code} (pas de doublon possible)
        getAfter(/databases/$(database)/documents/codes/$(request.resource.data.code)).data.c == id
        && request.resource.data.keys().hasOnly(['code','prenom','nomFamille','nom','tel','email','points','depuis','accord','parrain','anniv'])
        && (!('anniv' in request.resource.data) || (request.resource.data.anniv is string && request.resource.data.anniv.matches('(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])')))
        && (!('parrain' in request.resource.data) || (request.resource.data.parrain is string && request.resource.data.parrain.matches('RAD-[A-Z0-9]{5}') && request.resource.data.parrain != request.resource.data.code))
        && request.resource.data.keys().hasAll(['code','prenom','nomFamille','nom','tel','email','points','depuis','accord'])
        && request.resource.data.prenom is string && request.resource.data.prenom.size() > 0 && request.resource.data.prenom.size() <= 40
        && request.resource.data.nomFamille is string && request.resource.data.nomFamille.size() > 0 && request.resource.data.nomFamille.size() <= 40
        && request.resource.data.email is string && request.resource.data.email.size() <= 100 && request.resource.data.email.matches('[^@ ]+@[^@ ]+[.][a-z]{2,}')
        && request.resource.data.points == 0
        && request.resource.data.code is string && request.resource.data.code.matches('RAD-[A-Z0-9]{5}')
        && request.resource.data.nom is string && request.resource.data.nom.size() > 0 && request.resource.data.nom.size() <= 60
        && request.resource.data.tel is string && request.resource.data.tel.size() <= 20
        && request.resource.data.depuis is string && request.resource.data.depuis.size() <= 10
        && request.resource.data.accord is string && request.resource.data.accord.size() <= 10);
      // le titulaire (qui connaît l'identifiant secret de sa carte) peut corriger ses coordonnées, et rien d'autre
      allow update: if estAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prenom','nomFamille','nom','tel','email','anniv'])
        && (!('anniv' in request.resource.data) || (request.resource.data.anniv is string && (request.resource.data.anniv == '' || request.resource.data.anniv.matches('(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])'))))
        && request.resource.data.prenom is string && request.resource.data.prenom.size() > 0 && request.resource.data.prenom.size() <= 40
        && request.resource.data.nomFamille is string && request.resource.data.nomFamille.size() > 0 && request.resource.data.nomFamille.size() <= 40
        && request.resource.data.nom is string && request.resource.data.nom.size() > 0 && request.resource.data.nom.size() <= 60
        && request.resource.data.tel is string && request.resource.data.tel.size() <= 20
        && request.resource.data.email is string && request.resource.data.email.size() <= 100 && request.resource.data.email.matches('[^@ ]+@[^@ ]+[.][a-z]{2,}'))
        // au 10e tampon, le titulaire choisit dans l'appli : « je vais chercher mon cadeau » ou « je continue »
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['choix','choixLe'])
          && request.resource.data.choix in ['cadeau','continue']
          && request.resource.data.choixLe is int && request.resource.data.choixLe <= request.time.toMillis() + 600000)
        // roue de Noël : le titulaire peut seulement refuser / réactiver la roue et marquer ses tours comme vus.
        // Les résultats (gagné / perdu) et les tickets sont écrits par la caisse : impossible de tricher depuis l'appli.
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roueNon','roueAJouer'])
          // « vus » : la liste ne peut que perdre des tours (jamais en gagner ni en changer)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['roueAJouer'])
            || (request.resource.data.roueAJouer is list && (request.resource.data.roueAJouer.size() == 0
              || ('roueAJouer' in resource.data && resource.data.roueAJouer is list
                && request.resource.data.roueAJouer.size() < resource.data.roueAJouer.size()
                && resource.data.roueAJouer.hasAll(request.resource.data.roueAJouer)))))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['roueNon']) || request.resource.data.roueNon is bool));
      allow delete: if estAdmin();   // seule l'épicerie supprime une carte
      match /historique/{h} {
        allow read: if true;              // consultation par le titulaire
        allow delete: if estAdmin();
        allow create, update: if estAdmin();
      }
    }
  }
}
